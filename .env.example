PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=replace-with-your-postgres-password
PORT=3000
FRONTEND_ORIGINS=https://your-site.netlify.app
# Optional chat model settings (needs requirements-ai.txt)
CHAT_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
CHAT_MAX_NEW_TOKENS=512
# Hosted chat (used instead of the local model when CHAT_API_KEY is set). Any OpenAI-compatible API, e.g.
#   Alibaba Cloud Model Studio: CHAT_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  CHAT_API_MODEL=qwen-plus
#   OpenRouter:                 CHAT_API_BASE_URL=https://openrouter.ai/api/v1                         CHAT_API_MODEL=qwen/qwen-2.5-7b-instruct
CHAT_API_KEY=
CHAT_API_BASE_URL=
CHAT_API_MODEL=
